{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/app/**/*.ts", "src/app/**/*.tsx", "src/components/app-shell.tsx", "src/components/dashboard.tsx", "src/components/job-card.tsx", "src/lib/prisma.ts", "src/lib/types.ts", "src/lib/mock-data.ts", "src/lib/utils.ts", "prisma/seed.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/components/ui", "src/hooks", "src/App.tsx", "src/main.tsx", "src/business.tsx", "src/lib/auth.ts", "vite.config.ts"]
}
